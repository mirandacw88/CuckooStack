#!/bin/sh
# Every commit is tested: builds the desktop target and runs all the unit tests (ctest). A failing build or test
# stops the commit. Enabled per clone with:  git config core.hooksPath .githooks
# (It tests the working tree, so unstaged edits count too.)
set -e
root=$(git rev-parse --show-toplevel)
build="$root/build"

if [ ! -f "$build/CMakeCache.txt" ]; then
    echo "pre-commit: configuring $build"
    cmake -S "$root" -B "$build" -G Ninja >/dev/null
fi

echo "pre-commit: building..."
if ! cmake --build "$build" >/tmp/cuckoo-precommit-build.log 2>&1; then
    tail -40 /tmp/cuckoo-precommit-build.log
    echo "pre-commit: the build failed; commit stopped (full log: /tmp/cuckoo-precommit-build.log)"
    exit 1
fi

echo "pre-commit: running the unit tests..."
if ! ctest --test-dir "$build" --output-on-failure; then
    echo "pre-commit: tests failed; commit stopped"
    exit 1
fi
echo "pre-commit: all tests passed"
