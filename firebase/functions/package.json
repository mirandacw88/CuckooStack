{
  "name": "cuckoostack-functions",
  "private": true,
  "description": "Cloud Functions for Cuckoo Stack: purchase verification + cloud wallet (verifyPurchase), friend nudges.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "products": "node -e \"require('fs').copyFileSync('../../config/store/products.json','src/products.json')\"",
    "build": "npm run products && tsc",
    "test": "npm run build && node --test lib/*.test.js",
    "serve": "npm run build && firebase emulators:start"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@googleapis/androidpublisher": "^42.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
