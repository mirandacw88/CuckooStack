# Daily leaderboards (Phase 3). The game submits each run's distance (metres).
#
# Game Center (App Store Connect > your app > Game Center > Leaderboards): create, in BOTH apps (staging + prod),
#   - a RECURRING leaderboard, daily reset at 00:00 (UTC or your launch timezone), "Best score", integer, id below
#   - a CLASSIC leaderboard for the all-time best, id below
GAMECENTER_DAILY=cuckoostack.daily_distance
GAMECENTER_ALLTIME=cuckoostack.best_distance

# Play Games Services v2 (Play Console > Play Games Services > Setup and management), one project per app:
#   - the numeric project ID (also called "app ID")
#   - one leaderboard ("Distance", larger is better); Play shows daily / weekly / all-time views of it
# Leave empty until the projects exist: the game then hides the leaderboard button on Android.
PLAY_GAMES_APP_ID_STAGING=
PLAY_GAMES_APP_ID_PROD=
PLAY_LEADERBOARD_STAGING=
PLAY_LEADERBOARD_PROD=
