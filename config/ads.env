# AdMob IDs for Cuckoo Stack: one file for both platforms.
#
#   *_TEST  used by Debug builds (Xcode Run, ./gradlew installDebug). Keep Google's official test IDs here:
#           they're always safe to load and click.
#   *_PROD  used by Release builds (App Store / Google Play). Paste your own IDs from the AdMob console.
#           If a PROD value is left empty, Release falls back to TEST and the build prints a warning.
#
# App IDs contain "~", ad unit IDs contain "/". The ad units are *rewarded* units (watch a video for 3 lives).
# After editing, rebuild: Gradle and Xcode pick the file up automatically.

# ---- Android
ADMOB_ANDROID_APP_ID_TEST=ca-app-pub-3940256099942544~3347511713
ADMOB_ANDROID_APP_ID_PROD=
ADMOB_ANDROID_REWARDED_TEST=ca-app-pub-3940256099942544/5224354917
ADMOB_ANDROID_REWARDED_PROD=

# ---- iOS
ADMOB_IOS_APP_ID_TEST=ca-app-pub-3940256099942544~1458002511
ADMOB_IOS_APP_ID_PROD=
ADMOB_IOS_REWARDED_TEST=ca-app-pub-3940256099942544/1712485313
ADMOB_IOS_REWARDED_PROD=
