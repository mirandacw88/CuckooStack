# AdMob IDs for Cuckoo Stack: one file for both platforms.
#
#   *_TEST  Google's official test IDs. Used by every staging build and by prod Debug builds. Always safe to load
#           and tap; keep them as they are.
#   *_PROD  your own IDs from the AdMob console. Used only by prod Release builds (App Store / Google Play).
#           A prod Release build FAILS if any of them is empty, so test ads can never ship by accident.
#
# App IDs contain "~", ad unit IDs contain "/".
#   REWARDED      rewarded video units (Continue, x2 coins, boosts, free coins, ...: src/core/Monetization.h)
#   INTERSTITIAL  full-screen units shown between runs (every 3 runs, rules in src/core/Monetization.h)
# After editing, rebuild: Gradle and Xcode pick the file up automatically.

# ---- Android
ADMOB_ANDROID_APP_ID_TEST=ca-app-pub-3940256099942544~3347511713
ADMOB_ANDROID_APP_ID_PROD=
ADMOB_ANDROID_REWARDED_TEST=ca-app-pub-3940256099942544/5224354917
ADMOB_ANDROID_REWARDED_PROD=
ADMOB_ANDROID_INTERSTITIAL_TEST=ca-app-pub-3940256099942544/1033173712
ADMOB_ANDROID_INTERSTITIAL_PROD=

# ---- iOS
ADMOB_IOS_APP_ID_TEST=ca-app-pub-3940256099942544~1458002511
ADMOB_IOS_APP_ID_PROD=
ADMOB_IOS_REWARDED_TEST=ca-app-pub-3940256099942544/1712485313
ADMOB_IOS_REWARDED_PROD=
ADMOB_IOS_INTERSTITIAL_TEST=ca-app-pub-3940256099942544/4411468910
ADMOB_IOS_INTERSTITIAL_PROD=
