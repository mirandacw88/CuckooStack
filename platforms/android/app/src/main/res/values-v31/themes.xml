<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CuckooStack" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Android 12+ system splash: plain logo-background colour (see drawable/splash_blank.xml) -->
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
    </style>
</resources>
